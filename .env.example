# Copy to .env (local) or set the same names in Railway → Variables

# Supabase → Settings → API
#   Project URL  → SUPABASE_URL
#   service_role (secret) → SUPABASE_SERVICE_KEY  —  use this on the server only, never in the app
#   (Also accepted: SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# Server
PORT=3000
NODE_ENV=production
ORDER_RETENTION_DAYS=14
